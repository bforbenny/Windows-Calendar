<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WindowsCalendar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsCalendar">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Colour roles (ui-colour-theme R3). -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#D2D4D9" />
                    <SolidColorBrush x:Key="ShadeTodayBrush" Color="#F4F7FE" />
                    <SolidColorBrush x:Key="ShadeNonWorkingBrush" Color="#FBF6F8" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#16181A" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E535C" />
                    <SolidColorBrush x:Key="TodayChipBrush" Color="#155CEE" />
                    <SolidColorBrush x:Key="TodayChipTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NowLineBrush" Color="#CD1E1E" />
                    <SolidColorBrush x:Key="DestructiveBrush" Color="#CD1E1E" />
                    <SolidColorBrush x:Key="DestructiveHoverBrush" Color="#A31717" />
                    <SolidColorBrush x:Key="DestructivePressedBrush" Color="#801212" />
                    <SolidColorBrush x:Key="TextOnDestructiveBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#121824" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#2E3F61" />
                    <SolidColorBrush x:Key="ShadeTodayBrush" Color="#0F1E3C" />
                    <SolidColorBrush x:Key="ShadeNonWorkingBrush" Color="#201928" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EBEFF5" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8B7D5" />
                    <SolidColorBrush x:Key="TodayChipBrush" Color="#6E9BF4" />
                    <SolidColorBrush x:Key="TodayChipTextBrush" Color="#121824" />
                    <SolidColorBrush x:Key="NowLineBrush" Color="#EC7A7A" />
                    <SolidColorBrush x:Key="DestructiveBrush" Color="#EC7A7A" />
                    <SolidColorBrush x:Key="DestructiveHoverBrush" Color="#F1A1A1" />
                    <SolidColorBrush x:Key="DestructivePressedBrush" Color="#E54B4B" />
                    <SolidColorBrush x:Key="TextOnDestructiveBrush" Color="#121824" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ShadeTodayBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ShadeNonWorkingBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TodayChipBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TodayChipTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="NowLineBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DestructiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DestructiveHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DestructivePressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TextOnDestructiveBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
