<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow
    x:Class="WindowsCalendar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:WindowsCalendar.Views"
    Title="WindowsCalendar"
    Width="1400" Height="900" MinWidth="1000" MinHeight="640"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True">

    <ui:FluentWindow.Resources>
        <!-- Rows of the search and conflicts lists: theme surfaces for hover and selection, not the system highlight
             (ui-colour-theme). -->
        <Style x:Key="PopupListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <!-- Mica shows through the title bar only; the content area is solid (app-platform R2). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Title="WindowsCalendar" />

        <Grid Grid.Row="1">

            <!-- Settings page: replaces the toolbar and views while open (settings-page R1). -->
            <Border x:Name="SettingsHost" Panel.ZIndex="1" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBaseBrush}" />

            <Grid x:Name="ContentArea" Background="{DynamicResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar (calendar-views R1, R1a: no Previous/Next; views scroll). -->
                <Grid x:Name="Toolbar" Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Hides and shows the sidebar, also Ctrl+B (calendar-views R2b). -->
                    <ui:Button x:Name="SidebarButton" Click="OnToggleSidebar" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Hide or show the sidebar (Ctrl+B)" AutomationProperties.Name="Hide or show the sidebar">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE700;" FontSize="16" />
                    </ui:Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- New event, or New task in the Tasks view; the drop-down offers both (calendar-views interim). -->
                        <ui:SplitButton x:Name="NewButton" Click="OnNew" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="NewButtonText" Text="New event" />
                            <ui:SplitButton.Flyout>
                                <ContextMenu Opened="OnNewMenuOpening">
                                    <MenuItem Header="New event" Click="OnNewEvent">
                                        <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE787;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="NewTaskItem" Header="New task" Click="OnNewTask">
                                        <MenuItem.Icon><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:SplitButton.Flyout>
                        </ui:SplitButton>
                        <!-- Quick add (quick-add R1): a typed phrase becomes an event or task; Ctrl+N focuses it. -->
                        <views:QuickAddBox x:Name="QuickBox" Width="320" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:Button x:Name="TodayButton" Content="Today" Click="OnToday" VerticalAlignment="Center"
                                   ToolTip="Go to today (T)" />
                    </StackPanel>
                    <TextBlock x:Name="PeriodTitle" Grid.Column="2" Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="ViewSwitcher" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ToggleButton Content="Week" Tag="Week" IsChecked="True" Click="OnViewClicked" Margin="0,0,4,0" />
                        <ToggleButton Content="Month" Tag="Month" Click="OnViewClicked" Margin="0,0,4,0" />
                        <ToggleButton Content="Agenda" Tag="Agenda" Click="OnViewClicked" Margin="0,0,4,0" />
                        <ToggleButton Content="Tasks" Tag="Tasks" Click="OnViewClicked" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <!-- Search (search R2): results drop down as you type; also Ctrl+F / Ctrl+E. -->
                        <ui:TextBox x:Name="SearchBox" Width="240" Margin="0,0,8,0" VerticalAlignment="Center"
                                    PlaceholderText="Search" AutomationProperties.Name="Search events and tasks"
                                    TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchKeyDown">
                            <ui:TextBox.Icon>
                                <ui:SymbolIcon Symbol="Search24" />
                            </ui:TextBox.Icon>
                        </ui:TextBox>
                        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0">
                                <ListBox x:Name="SearchResults" MaxHeight="480" Width="440" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource PopupListItem}"
                                         PreviewMouseLeftButtonUp="OnSearchResultClicked" PreviewKeyDown="OnSearchResultsKeyDown" />
                            </Border>
                        </Popup>
                        <ui:Button x:Name="SyncButton" Click="OnSyncNow" VerticalAlignment="Center" Margin="0,0,4,0"
                                   ToolTip="Sync now (F5)" AutomationProperties.Name="Sync now">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE895;" FontSize="16" />
                        </ui:Button>
                        <!-- Settings page (settings-page R1 interim), also Ctrl+,. -->
                        <ui:Button x:Name="SettingsButton" Click="OnOpenSettings" VerticalAlignment="Center"
                                   ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="16" />
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="Body" Grid.Row="1">
                    <Grid x:Name="ViewHost" />

                    <!-- First launch, no accounts (ui-states R5). -->
                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Add an account to get started" Style="{StaticResource SubtitleTextBlockStyle}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button x:Name="AddMs365Button" Content="Microsoft 365" Click="OnAddMs365" Margin="0,0,8,0" />
                            <ui:Button x:Name="AddRadicaleButton" Content="Radicale" Appearance="Primary" Click="OnAddRadicale" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Sidebar (calendar-views R2, R2b): overlays the views on the left, below the toolbar, so they never resize.
                         Interim: accounts and their collections (account-management). -->
                    <Border x:Name="Sidebar" Width="260" HorizontalAlignment="Left"
                            Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Calendar set selector and its options menu, also Ctrl+1 … Ctrl+9 (calendar-sets R3, R4). -->
                            <DockPanel x:Name="SetBar" Margin="12,8,12,0" Visibility="Collapsed">
                                <ui:Button x:Name="SetMenuButton" DockPanel.Dock="Right" Margin="4,0,0,0" Click="OnSetMenu"
                                           ToolTip="Calendar set options" AutomationProperties.Name="Calendar set options">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE712;" FontSize="16" />
                                </ui:Button>
                                <ComboBox x:Name="SetSelector" SelectionChanged="OnSetSelected" AutomationProperties.Name="Calendar set" />
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AccountList" Margin="12,8" />
                            </ScrollViewer>
                            <ui:Button x:Name="AddAccountLink" Grid.Row="2" Margin="8" Content="Add account" Appearance="Transparent"
                                       Visibility="Collapsed" Click="OnAddAccount" />
                        </Grid>
                    </Border>

                    <!-- Event and task editor (calendar-views R6c): overlays the views on the right at every width. -->
                    <Border x:Name="EditorHost" HorizontalAlignment="Right" Visibility="Collapsed"
                            Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1,0,0,0" />

                    <!-- Banners float over the views and editor, bottom centre, so nothing moves (floating-banners R1-R4).
                         Lasting conditions above, passing ones (undo) below. Only the cards take clicks. -->
                    <StackPanel x:Name="BannerStack" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="24" MinWidth="320" MaxWidth="520">
                        <!-- Conflicts (conflict-resolution R5, interim: banner only). -->
                        <ui:InfoBar x:Name="ConflictBar" Severity="Warning" IsClosable="True" Margin="0,0,0,8"
                                    Background="{DynamicResource SurfaceBaseBrush}" Cursor="Hand"
                                    MouseLeftButtonUp="OnConflictBarClicked">
                            <ui:InfoBar.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
                            </ui:InfoBar.Effect>
                            <!-- Lists the conflicts; a row opens its item (conflict-resolution R5 interim). -->
                            <ui:Button x:Name="ConflictShowButton" Content="Show" Click="OnShowConflicts" />
                        </ui:InfoBar>
                        <Popup x:Name="ConflictPopup" PlacementTarget="{Binding ElementName=ConflictBar}" Placement="Top"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource SurfaceBaseBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,4">
                                <ListBox x:Name="ConflictList" MaxHeight="400" Width="440" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="Conflicts"
                                         ItemContainerStyle="{StaticResource PopupListItem}"
                                         PreviewMouseLeftButtonUp="OnConflictRowClicked" PreviewKeyDown="OnConflictListKeyDown" />
                            </Border>
                        </Popup>
                        <!-- Added to a calendar that is hidden in the sidebar (quick-add R4). -->
                        <ui:InfoBar x:Name="HiddenBar" IsClosable="True" Margin="0,0,0,8"
                                    Background="{DynamicResource SurfaceBaseBrush}">
                            <ui:InfoBar.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
                            </ui:InfoBar.Effect>
                            <ui:Button x:Name="HiddenShowButton" Content="Show" Click="OnShowHidden" />
                        </ui:InfoBar>
                        <!-- "Event moved · Undo" for 8 seconds (undo R3). -->
                        <ui:InfoBar x:Name="UndoBar" IsClosable="True" Background="{DynamicResource SurfaceBaseBrush}">
                            <ui:InfoBar.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
                            </ui:InfoBar.Effect>
                            <ui:Button x:Name="UndoButton" Content="Undo" Click="OnUndo" />
                        </ui:InfoBar>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Shortcut badges while Ctrl is held (keyboard-navigation interim); never takes clicks. -->
        <Canvas x:Name="KeyHintLayer" Grid.Row="1" IsHitTestVisible="False" Panel.ZIndex="10" />

        <!-- Content dialogs (WPF-UI) cover the whole window while open. -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
