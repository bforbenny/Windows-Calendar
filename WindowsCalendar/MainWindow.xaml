<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsCalendar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsCalendar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WindowsCalendar">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Mica shows through the title bar and sidebar only; the content area is solid (app-platform R2). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="WindowsCalendar" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar (calendar-views R2). Interim: accounts and their collections (account-management). -->
            <Grid x:Name="Sidebar" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer>
                    <StackPanel x:Name="AccountList" Padding="12,8" Spacing="2" />
                </ScrollViewer>
                <HyperlinkButton x:Name="AddAccountLink" Grid.Row="1" Margin="8" Content="Add Radicale account"
                                 Visibility="Collapsed" Click="OnAddRadicale" />
            </Grid>

            <Grid x:Name="ContentArea" Grid.Column="1" Background="{ThemeResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar (calendar-views R1, R1a: no Previous/Next; views scroll). Interim: no quick add or sync status yet. -->
                <Grid x:Name="Toolbar" Padding="12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Today" Click="OnToday" VerticalAlignment="Center" />
                    <TextBlock x:Name="PeriodTitle" Grid.Column="1" Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                    <SelectorBar x:Name="ViewSwitcher" Grid.Column="2" SelectionChanged="OnViewChanged">
                        <SelectorBarItem Text="Week" Tag="Week" IsSelected="True" />
                        <SelectorBarItem Text="Month" Tag="Month" />
                        <SelectorBarItem Text="Agenda" Tag="Agenda" />
                    </SelectorBar>
                    <Button Grid.Column="3" Click="OnSyncNow" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Sync now" AutomationProperties.Name="Sync now">
                        <FontIcon Glyph="&#xE895;" />
                    </Button>
                </Grid>

                <Grid x:Name="Body" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="ViewHost" />

                    <!-- First launch, no accounts (ui-states R5). -->
                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                                Visibility="Collapsed">
                        <TextBlock Text="Add an account to get started" Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <!-- Interim: MS365 sign-in comes in the next account-management slice. -->
                            <Button Content="Microsoft 365" IsEnabled="False" />
                            <Button x:Name="AddRadicaleButton" Content="Radicale" Style="{StaticResource AccentButtonStyle}"
                                    Click="OnAddRadicale" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Event editor (calendar-views R6c): pushes the views at 1200 epx and wider, slides over them below. -->
                    <Border x:Name="EditorHost" Grid.Column="1" Visibility="Collapsed"
                            Background="{ThemeResource SurfaceBaseBrush}" BorderBrush="{ThemeResource DividerBrush}"
                            BorderThickness="1,0,0,0" />

                    <!-- Banners float over the views and editor, bottom centre, so nothing moves (floating-banners R1-R4).
                         Lasting conditions above, passing ones (undo) below. Only the cards take clicks. -->
                    <StackPanel x:Name="BannerStack" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="24" Spacing="8" MinWidth="320" MaxWidth="520">
                        <!-- Conflicts (conflict-resolution R5, interim: banner only). -->
                        <InfoBar x:Name="ConflictBar" Severity="Warning" IsClosable="True" Closed="OnConflictBarClosed"
                                 Background="{ThemeResource SurfaceBaseBrush}">
                            <InfoBar.Shadow>
                                <ThemeShadow />
                            </InfoBar.Shadow>
                        </InfoBar>
                        <!-- "Event moved · Undo" for 8 seconds (undo R3). -->
                        <InfoBar x:Name="UndoBar" IsClosable="True" Background="{ThemeResource SurfaceBaseBrush}">
                            <InfoBar.Shadow>
                                <ThemeShadow />
                            </InfoBar.Shadow>
                            <InfoBar.ActionButton>
                                <Button x:Name="UndoButton" Content="Undo" Click="OnUndo" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
