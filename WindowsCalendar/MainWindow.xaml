<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow
    x:Class="WindowsCalendar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="WindowsCalendar"
    Width="1400" Height="900" MinWidth="1000" MinHeight="640"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True">

    <!-- Mica shows through the title bar and sidebar only; the content area is solid (app-platform R2). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Title="WindowsCalendar" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar (calendar-views R2). Interim: accounts and their collections (account-management). -->
            <Grid x:Name="Sidebar" Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AccountList" Margin="12,8" />
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ContentArea" Grid.Column="1" Background="{DynamicResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar (calendar-views R1, R1a: no Previous/Next; views scroll). -->
                <Grid x:Name="Toolbar" Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Hides and shows the sidebar, also Ctrl+B (calendar-views R2b). -->
                    <ui:Button x:Name="SidebarButton" Click="OnToggleSidebar" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="Hide or show the sidebar (Ctrl+B)" AutomationProperties.Name="Hide or show the sidebar">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE700;" FontSize="16" />
                    </ui:Button>
                    <ui:Button x:Name="TodayButton" Grid.Column="1" Content="Today" Click="OnToday" VerticalAlignment="Center"
                               ToolTip="Go to today (T)" />
                    <TextBlock x:Name="PeriodTitle" Grid.Column="2" Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="ViewSwitcher" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ToggleButton Content="Week" Tag="Week" IsChecked="True" Click="OnViewClicked" Margin="0,0,4,0" />
                        <ToggleButton Content="Month" Tag="Month" Click="OnViewClicked" Margin="0,0,4,0" />
                        <ToggleButton Content="Agenda" Tag="Agenda" Click="OnViewClicked" />
                    </StackPanel>
                    <ui:Button x:Name="SyncButton" Grid.Column="4" Click="OnSyncNow" VerticalAlignment="Center"
                               ToolTip="Sync now (F5)" AutomationProperties.Name="Sync now">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE895;" FontSize="16" />
                    </ui:Button>
                </Grid>

                <Grid x:Name="Body" Grid.Row="1">
                    <Grid x:Name="ViewHost" />

                    <!-- First launch, no accounts (ui-states R5). Adding accounts comes with the WPF port's third slice. -->
                    <TextBlock x:Name="EmptyPanel" Text="Add an account to get started" Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
