<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WindowsCalendar.AddRadicaleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Radicale account"
    PrimaryButtonText="Connect"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnConnect">

    <!-- account-management R4, R4a, R7 -->
    <StackPanel Width="380" Spacing="12">
        <TextBox x:Name="ServerUrlBox" Header="Server address" PlaceholderText="https://calendar.example.com/" InputScope="Url" />
        <TextBox x:Name="UsernameBox" Header="Username" />
        <PasswordBox x:Name="PasswordInput" Header="Password" />
        <TextBox x:Name="EmailBox" Header="Email address (optional)" InputScope="EmailNameOrAddress"
                 PlaceholderText="Used to tell meetings you organise" />
        <TextBox x:Name="DisplayNameBox" Header="Account name (optional)" PlaceholderText="Defaults to the server name" />
        <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />
        <ProgressRing x:Name="Progress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
    </StackPanel>
</ContentDialog>
